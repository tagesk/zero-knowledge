% Need to compare strings (lualatex: using `\pdf@strcmp` from `pdftexcmds`)
% From https://tex.stackexchange.com/questions/391735/question-of-ifstrequal-in-etoolbox
\newcommand{\@ifstringequal}[4]{%
  \ifthenelse{\equal{#1}{#2}}{#3}{#4}}


